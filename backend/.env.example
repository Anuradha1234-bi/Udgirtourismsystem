# Explore Udgir Tourism API Environment Configuration Template
# Copy this file to .env to configure your environment: cp .env.example .env
# NEVER commit the actual .env file or real secrets to version control.

# Environment Mode: 'development' for local work, 'production' for live deployments
ENVIRONMENT=development

# Server Configuration
PROJECT_NAME="Explore Udgir Tourism API"
VERSION="1.0.0"

# Database Connection
# SQLite local development fallback:
DATABASE_URL=sqlite:///./explore_udgir.db
# PostgreSQL production example:
# DATABASE_URL=postgresql://postgres:your_strong_db_password@localhost:5432/explore_udgir

# Security Settings
# In production, SECRET_KEY is MANDATORY (generate with: openssl rand -hex 32)
SECRET_KEY=your-secure-random-secret-key-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Admin Bootstrap Credentials (Only used during initial setup if no admin user exists)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_strong_admin_password_here
ADMIN_EMAIL=admin@exploreudgir.in

# CORS Allowed Origins
# Comma-separated list or JSON array of allowed origins (Wildcard '*' is forbidden when allow_credentials=True)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
